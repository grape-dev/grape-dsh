{
  "name": "@grape-dev/grape-dsh",
  "version": "0.5.4",
  "description": "Grape DevOps pipeline tools for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "README.md",
    "docs/README.zh.md",
    "docs/MIGRATION-rename-to-grape-dsh.md",
    "skills/**",
    "USER-DEPLOYMENT-GUIDE.md",
    "USER-DEPLOYMENT-GUIDE.zh.md",
    "AGENT-DEPLOYMENT-GUIDE.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grape-dev/grape-dsh.git"
  },
  "homepage": "https://github.com/grape-dev/grape-dsh#readme",
  "bugs": {
    "url": "https://gitcode.com/grape-dev/grape-dsh/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-0",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "node scripts/build-client.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepare": "tsc"
  }
}
